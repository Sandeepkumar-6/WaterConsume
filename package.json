{
  "name": "smart-water-portal",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "npm start -w server",
    "predev": "npm run setup",
    "dev": "concurrently -k -n API,WEB \"npm run dev -w server\" \"npm run dev -w client\"",
    "setup": "node scripts/setup.mjs",
    "seed": "npm run seed -w server",
    "seed:reset": "npm run seed:reset -w server",
    "build": "npm run build -w client",
    "test": "npm test -w server",
    "test:e2e": "node scripts/e2e.mjs",
    "format": "prettier --write client/src server scripts tests *.json *.js *.md"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.6"
  }
}
