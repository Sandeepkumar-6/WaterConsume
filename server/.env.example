PORT=5000
MONGO_URI=mongodb://localhost:27017/smart_water_portal
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
FRONTEND_URL=http://localhost:5173
# Render terminates TLS at one reverse proxy. Use 1 on Render, 0 locally.
TRUST_PROXY_HOPS=0
# Only needed when explicitly running the optional seed on an empty database.
SEED_ADMIN_PASSWORD=replace_with_a_demo_admin_password
SEED_STAFF_PASSWORD=replace_with_a_demo_staff_password
